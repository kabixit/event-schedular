{{#if (eq editingEventId event.id)}}
  <div>
    {{input 
      value=editedEventTitle 
      class="form-control mb-3 premium-input" 
      placeholder="Edit title"
    }}
    <input 
      type="datetime-local" 
      class="form-control mb-3 premium-input" 
      value={{editedEventDate}} 
      onchange={{action (mut editedEventDate) value="target.value"}}
    >
    {{textarea 
      value=editedEventDescription 
      class="form-control mb-3 premium-input" 
      placeholder="Edit description" 
      rows="3"
    }}
  </div>

  <div class="d-flex gap-2">
    <button 
      class="btn btn-success btn-sm px-4 rounded-pill shadow-sm" 
      {{action "saveEdit" event}}
    >
      Save
    </button>
    <button 
      class="btn btn-outline-secondary btn-sm px-4 rounded-pill" 
      {{action "cancelEdit"}}
    >
      Cancel
    </button>
  </div>

{{else}}
  <div>
    <h5 class="fw-bold text-dark mb-1">{{event.title}}</h5>
    <div class="small text-muted mb-2">
      {{moment-format event.date 'LLLL'}}
    </div>
    {{#if event.description}}
      <p class="text-secondary small mb-3">{{event.description}}</p>
    {{/if}}
  </div>

  <div class="d-flex flex-wrap gap-2">
    <button 
      class="btn btn-outline-warning btn-sm px-4 rounded-pill shadow-sm" 
      {{action "startEdit"}}
    >
      Edit
    </button>
    <button 
      class="btn btn-outline-danger btn-sm px-4 rounded-pill shadow-sm" 
      {{action "deleteEvent"}}
      title="Delete event"
    >
      Delete
    </button>
  </div>
{{/if}}
