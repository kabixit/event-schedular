{{!-- calendar.hbs --}}
<div class="container py-4">
  <div class="mb-3 d-flex justify-content-end gap-2">
    <button {{action "setView" "week"}} class="btn btn-outline-primary {{if (eq currentView 'week') 'active'}}">Week</button>
    <button {{action "setView" "day"}} class="btn btn-outline-primary {{if (eq currentView 'day') 'active'}}">Day</button>
    <button {{action "setView" "month"}} class="btn btn-outline-primary {{if (eq currentView 'month') 'active'}}">Month</button>
    {{export-calendar events=events currentView=currentView currentMonth=currentMonth}}
  </div>

  {{#if (eq currentView "week")}}
    <div class="calendar-week-view">
      <div class="calendar-header">
        <div class="calendar-time-column"></div>
        {{#each model.days as |day|}}
          <div class="calendar-day-header {{if (eq day.date (today-date)) 'calendar-today'}}">
            <div class="calendar-day-name">{{day.shortLabel}}</div>
            <div class="calendar-date-number">{{moment-format day.date 'D'}}</div>
          </div>
        {{/each}}
      </div>
      
      <div class="calendar-body">
        <div class="calendar-time-column">
          {{#each model.hours as |hour|}}
            <div class="calendar-hour-marker">{{if (lt hour 10) (concat "0" hour) hour}}:00</div>
          {{/each}}
        </div>
        
        <div class="calendar-day-columns">
          {{#each model.days as |day|}}
            <div class="calendar-day-column {{if (eq day.date (today-date)) 'calendar-today'}}">
              {{#each model.hours as |hour|}}
                <div class="calendar-hour-slot"
                  draggable="false"
                  ondrop={{action "handleDrop" day.date hour}}
                  ondragover={{action "allowDrop"}}
                  {{action "openAddEventModal" day.date hour}}>
                  
                  {{#each (filter-by-hour events day.date hour) as |event|}}
                    <div class="calendar-event"
                      draggable="true"
                      ondragstart={{action "handleDragStart" event}}
                      {{action "stopPropagation"}}>
                      <div class="calendar-event-content">
                        <div class="calendar-event-time">{{format-time event.date}}</div>
                        <div class="calendar-event-title">{{event.title}}</div>
                      </div>
                      <div class="calendar-event-actions">
                        <button type="button" class="btn btn-sm btn-outline-light rounded-circle px-1 py-0 lh-1"
                          {{action "deleteEvent" event.id bubbles=false}}>×</button>
                        <button type="button" class="btn btn-sm btn-light text-primary rounded-pill px-2 py-0 fw-semibold border lh-1"
                          {{action "openEditEventModal" event bubbles=false}}>Edit</button>
                      </div>
                    </div>
                  {{/each}}
                </div>
              {{/each}}
            </div>
          {{/each}}
        </div>
      </div>
    </div>

  {{else if (eq currentView "day")}}
    <div class="calendar-day-view">
      <div class="calendar-day-header">
        <h4>{{moment-format (now) 'dddd, MMMM Do YYYY'}}</h4>
      </div>
      
      <div class="calendar-day-body">
        {{#each model.hours as |hour|}}
          <div class="calendar-hour-row">
            <div class="calendar-hour-marker">{{if (lt hour 10) (concat "0" hour) hour}}:00</div>
            <div class="calendar-hour-content"
              {{action "openAddEventModal" (today-date) hour}}>
              
              {{#each (filter-by-hour events (today-date) hour) as |event|}}
                <div class="calendar-event"
                  draggable="true"
                  ondragstart={{action "handleDragStart" event}}
                  {{action "stopPropagation"}}>
                  <div class="calendar-event-content">
                    <div class="calendar-event-time">{{format-time event.date}}</div>
                    <div class="calendar-event-title">{{event.title}}</div>
                    <div class="calendar-event-description">{{event.description}}</div>
                  </div>
                  <div class="calendar-event-actions">
                    <button {{action "openEditEventModal" event bubbles=false}} class="btn btn-sm btn-outline-primary me-2">Edit</button>
                    <button {{action "deleteEvent" event.id bubbles=false}} class="btn btn-sm btn-outline-danger">Delete</button>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        {{/each}}
      </div>
    </div>

  {{else}}
    <div class="calendar-month-view">
      <div class="calendar-month-header">
        <button class="btn btn-outline-secondary btn-sm" {{action "prevMonth"}}>← Prev</button>
        <h4>{{moment-format currentMonth 'MMMM YYYY'}}</h4>
        <button class="btn btn-outline-secondary btn-sm" {{action "nextMonth"}}>Next →</button>
      </div>
      
      <div class="calendar-month-grid">
        <div class="calendar-weekdays-header">
          <div class="calendar-weekday">Sun</div>
          <div class="calendar-weekday">Mon</div>
          <div class="calendar-weekday">Tue</div>
          <div class="calendar-weekday">Wed</div>
          <div class="calendar-weekday">Thu</div>
          <div class="calendar-weekday">Fri</div>
          <div class="calendar-weekday">Sat</div>
        </div>
        
        {{#each (month-grid currentMonth) as |week|}}
          <div class="calendar-week">
            {{#each week as |dateObj|}}
              <div class="calendar-day-cell {{unless dateObj.isCurrentMonth 'calendar-other-month'}} {{if (eq dateObj.date (today-date)) 'calendar-today'}}"
                draggable="false"
                ondrop={{action "handleDrop" dateObj.date 0}}
                ondragover={{action "allowDrop"}}
                {{action "openAddEventModal" dateObj.date 0}}>
                
                <div class="calendar-date-number">{{moment-format dateObj.date "D"}}</div>
                
                <div class="calendar-day-events">
                  {{#each (filter-by-date events dateObj.date) as |event|}}
                    <div class="calendar-event"
                      draggable="true"
                      ondragstart={{action "handleDragStart" event}}
                      {{action "stopPropagation"}}>
                      <div class="calendar-event-title">{{event.title}}</div>
                    </div>
                  {{/each}}
                </div>
              </div>
            {{/each}}
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  {{!-- Modal --}}
  <div class="modal fade" id="addEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content shadow-lg rounded-3">
        <form {{action "saveNewEvent" on="submit"}}>
          <div class="modal-header bg-primary text-white rounded-top">
            <h5 class="modal-title">{{if editingEventId "Edit Event" "Add Event"}}</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body bg-light">
            <div class="mb-3">
              <label class="form-label fw-semibold">Title</label>
              {{input value=newEventTitle class="form-control" required=true placeholder="Enter event title"}}
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              {{textarea value=newEventDescription class="form-control" placeholder="Optional details"}}
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Date & Time</label>
              {{input value=newEventDate class="form-control" type="datetime-local" }}
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-3">{{if editingEventId "Save Changes" "Add Event"}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>