{{!-- calendar.hbs --}}
<div class="container py-4">
  <div class="mb-3 d-flex justify-content-end gap-2">
    <button {{action "setView" "week"}} class="btn btn-outline-primary {{if (eq currentView 'week') 'active'}}">Week</button>
    <button {{action "setView" "day"}} class="btn btn-outline-primary {{if (eq currentView 'day') 'active'}}">Day</button>
    <button {{action "setView" "month"}} class="btn btn-outline-primary {{if (eq currentView 'month') 'active'}}">Month</button>
    {{export-calendar events=events}} {{! <-- Add this here }}
  </div>

  {{#if (eq currentView "week")}}
    <div class="table-responsive rounded overflow-hidden">
      <table class="table table-bordered text-center align-middle mb-0">
        <thead class="table-light sticky-top">
          <tr>
            <th class="bg-light text-nowrap">Time</th>
            {{#each model.days as |day|}}
              <th class="bg-light text-nowrap">{{day.label}}</th>
            {{/each}}
          </tr>
        </thead>
        <tbody>
          {{#each model.hours as |hour|}}
            <tr>
              <th class="align-middle text-nowrap bg-light">{{if (lt hour 10) (concat "0" hour) hour}}:00</th>
              {{#each model.days as |day|}}
                <td
                  class="calendar-cell position-relative"
                  style="min-width: 120px; height: 100px; padding: 2px;"
                  draggable="false"
                  ondrop={{action "handleDrop" day.date hour}}
                  ondragover={{action "allowDrop"}}
                  {{action "openAddEventModal" day.date hour}}
                >
                  {{#each events as |event|}}
                    {{#if (and (eq (format-date event.date) day.date) (eq (format-hour event.date) hour))}}
                      <div
                        class="bg-primary text-white rounded px-2 py-1 mb-1 small d-flex justify-content-between align-items-start shadow-sm"
                        draggable="true"
                        ondragstart={{action "handleDragStart" event}}
                        {{action "stopPropagation"}}
                      >
                        <div class="text-start" style="overflow: hidden; max-width: 75%;">
                          <div class="fw-semibold text-truncate">{{event.title}}</div>
                          <div class="small text-white-50">{{format-time event.date}}</div>
                        </div>
                        <div class="ms-1 d-flex flex-column align-items-end gap-1">
                          <button type="button" class="btn btn-sm btn-outline-light rounded-circle px-1 py-0"
                            {{action "deleteEvent" event.id bubbles=false}}>×</button>
                          <button type="button" class="btn btn-sm btn-light text-primary rounded-pill px-2 py-0 fw-semibold border"
                            {{action "openEditEventModal" event bubbles=false}}>Edit</button>
                        </div>
                      </div>
                    {{/if}}
                  {{/each}}
                </td>
              {{/each}}
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  {{else if (eq currentView "day")}}
    <div class="mb-2 fw-semibold">Today: {{moment-format (now) 'dddd, MMMM Do YYYY'}}</div>
    <div class="list-group">
      {{#each events as |event|}}
        {{#if (eq (format-date event.date) (today-date))}}
          <div class="list-group-item d-flex justify-content-between align-items-center shadow-sm">
            <div>
              <div class="fw-semibold">{{event.title}}</div>
              <div class="small text-muted">{{format-time event.date}}</div>
            </div>
            <div>
              <button {{action "openEditEventModal" event bubbles=false}} class="btn btn-sm btn-outline-primary me-2">Edit</button>
              <button {{action "deleteEvent" event.id bubbles=false}} class="btn btn-sm btn-outline-danger">Delete</button>
            </div>
          </div>
        {{/if}}
      {{else}}
        <div class="text-muted">No events today.</div>
      {{/each}}
    </div>

  {{else}}
    <div class="d-flex justify-content-between align-items-center mb-2">
      <button class="btn btn-outline-secondary btn-sm" {{action "prevMonth"}}>← Prev</button>
      <h5 class="mb-0">{{moment-format currentMonth 'MMMM YYYY'}}</h5>
      <button class="btn btn-outline-secondary btn-sm" {{action "nextMonth"}}>Next →</button>
    </div>

    <div class="table-responsive rounded overflow-hidden border">
      <table class="table table-bordered text-center mb-0 small">
        <thead class="table-light sticky-top">
          <tr>
            <th>Sun</th>
            <th>Mon</th>
            <th>Tue</th>
            <th>Wed</th>
            <th>Thu</th>
            <th>Fri</th>
            <th>Sat</th>
          </tr>
        </thead>
        <tbody>
          {{#each (month-grid currentMonth) as |week|}}
            <tr>
              {{#each week as |dateObj|}}
                <td class="position-relative p-1 {{if dateObj.isCurrentMonth '' 'bg-light text-muted'}}"
                    style="height: 100px; min-width: 120px;"
                    draggable="false"
                    ondrop={{action "handleDrop" dateObj.date 0}}
                    ondragover={{action "allowDrop"}}
                    {{action "openAddEventModal" dateObj.date 0}}
                >
                  <div class="position-absolute top-0 end-0 small text-muted m-1">{{moment-format dateObj.date "D"}}</div>

                  {{#each events as |event|}}
                    {{#if (eq (format-date event.date) dateObj.date)}}
                      <div class="bg-primary text-white rounded px-1 py-0 mb-1 small text-truncate"
                           draggable="true"
                           ondragstart={{action "handleDragStart" event}}
                           {{action "stopPropagation"}}
                      >
                        {{event.title}}
                      </div>
                    {{/if}}
                  {{/each}}
                </td>
              {{/each}}
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  {{!-- Modal --}}
  <div class="modal fade" id="addEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content shadow-lg rounded-3">
        <form {{action "saveNewEvent" on="submit"}}>
          <div class="modal-header bg-primary text-white rounded-top">
            <h5 class="modal-title">{{if editingEventId "Edit Event" "Add Event"}}</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body bg-light">
            <div class="mb-3">
              <label class="form-label fw-semibold">Title</label>
              {{input value=newEventTitle class="form-control" required=true placeholder="Enter event title"}}
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              {{textarea value=newEventDescription class="form-control" placeholder="Optional details"}}
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Date & Time</label>
              {{input value=newEventDate class="form-control" type="datetime-local" }}
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-3">{{if editingEventId "Save Changes" "Add Event"}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
