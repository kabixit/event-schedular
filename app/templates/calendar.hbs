<div class="container py-4">

  <div class="table-responsive rounded overflow-hidden">
    <table class="table table-bordered text-center align-middle mb-0">
      <thead class="table-light sticky-top">
        <tr>
          <th class="bg-light text-nowrap">Time</th>
          {{#each model.days as |day|}}
            <th class="bg-light text-nowrap">{{day.label}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each model.hours as |hour|}}
          <tr>
            <th class="align-middle text-nowrap bg-light">
              {{if (lt hour 10) (concat "0" hour) hour}}:00
            </th>
            {{#each model.days as |day|}}
              <td
                class="position-relative calendar-cell"
                style="min-width: 120px; height: 100px; padding: 2px; overflow-y: auto; cursor: pointer; transition: background-color 0.2s ease;"
                {{action "openAddEventModal" day.date hour}}
                onmouseover="this.style.backgroundColor='#f8f9fa';"
                onmouseout="this.style.backgroundColor='';"
                ondragover={{action "allowDrop"}}
                ondrop={{action "handleDrop" day.date hour}}
              >
                {{#each model.events as |event|}}
                  {{#if (and (eq (format-date event.date) day.date) (eq (format-hour event.date) hour))}}
                    <div
                      class="bg-primary text-white rounded px-2 py-1 mb-1 small d-flex justify-content-between align-items-start shadow-sm"
                      style="font-size: 0.75rem;"
                      draggable="true"
                      {{action "stopPropagation"}}
                      ondragstart={{action "handleDragStart" event}}
                    >
                      <div class="text-start" style="overflow: hidden; max-width: 75%;">
                        <div class="fw-semibold text-truncate">{{event.title}}</div>
                        <div class="small text-white-50">{{format-time event.date}}</div>
                      </div>
                      <div class="ms-1 d-flex flex-column align-items-end gap-1">
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-light rounded-circle px-1 py-0"
                          style="font-size: 0.65rem; border-width: 1px;"
                          title="Delete"
                          {{action "deleteEvent" event.id bubbles=false}}
                        >×</button>
                        <button
                          type="button"
                          class="btn btn-sm btn-light text-primary rounded-pill px-2 py-0 fw-semibold border"
                          style="font-size: 0.6rem;"
                          {{action "openEditEventModal" event bubbles=false}}
                        >Edit</button>
                      </div>
                    </div>
                  {{/if}}
                {{/each}}
              </td>
            {{/each}}
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <a href="/" class="btn btn-outline-secondary rounded-pill px-4">← Back to Events</a>
  </div>

  <!-- Modal for Add/Edit Event -->
  <div class="modal fade" id="addEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content shadow-lg rounded-3">
        <form {{action "saveNewEvent" on="submit"}}>
          <div class="modal-header bg-primary text-white rounded-top">
            <h5 class="modal-title">{{if editingEventId "Edit Event" "Add Event"}}</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body bg-light">
            <div class="mb-3">
              <label class="form-label fw-semibold">Title</label>
              {{input value=newEventTitle class="form-control" required=true placeholder="Enter event title"}}
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              {{textarea value=newEventDescription class="form-control" placeholder="Optional details"}}
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Date & Time</label>
              {{input value=newEventDate class="form-control" type="datetime-local" readonly=true}}
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-3">{{if editingEventId "Save Changes" "Add Event"}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
