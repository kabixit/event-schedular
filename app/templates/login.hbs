<div class="d-flex justify-content-center align-items-center min-vh-100 ">
  <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%;">
    <h2 class="text-center mb-4 fw-bold text-primary">Login</h2>

    {{#if errorMessage}}
      <div class="alert alert-danger">{{errorMessage}}</div>
    {{/if}}

    <form {{action "login" on="submit"}}>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        {{input value=username class="form-control form-control-lg" id="username" placeholder="Enter username"}}
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        {{input type="password" value=password class="form-control form-control-lg" id="password" placeholder="Enter password"}}
      </div>

      <button type="submit" class="btn btn-gradient px-4 py-2 w-100 rounded-pill shadow-sm fs-5">Login</button>
    </form>
  </div>
</div>
