<nav class="navbar navbar-expand-lg premium-navbar sticky-top shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold gradient-text fs-4" href="#">Event Manager</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-3 align-items-center">
        <li class="nav-item">
          {{#link-to "index" class="nav-link premium-link"}}Home{{/link-to}}
        </li>
        <li class="nav-item">
          {{#link-to "calendar" class="nav-link premium-link"}}Calendar{{/link-to}}
        </li>
        <li class="nav-item">
          <button class="btn btn-sm toggle-theme-btn rounded-pill px-3 py-1" {{action "toggleTheme"}}>
            🌓 <span class="d-none d-md-inline">Toggle Dark Mode</span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</nav>




<div class="container my-4">
  {{outlet}}
</div>

<!-- Alert Modal -->
<div class="modal fade" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="alertModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content shadow-lg rounded-4 border-0">
      <div class="modal-header bg-danger text-white rounded-top-4">
        <h5 class="modal-title fw-bold" id="alertModalLabel">⚠️ Warning</h5>
        <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="alertModalBody">
        <!-- Alert message will be set dynamically -->
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-danger px-4" data-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>