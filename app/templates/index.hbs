<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold display-7 text-dark mb-0">All Events</h2>

    <button 
      class="btn btn-gradient px-4 py-2 rounded-pill shadow-sm fs-5"
      {{action (mut showForm) (if showForm false true)}}
    >
      {{if showForm "Hide Form" "Add New Event"}}
    </button>
  </div>

  {{#if showForm}}
    {{add-event-form 
      newEventTitle=newEventTitle
      newEventDate=newEventDate
      newEventDescription=newEventDescription
      addEvent=(action "addEvent")
    }}
  {{/if}}

  {{#if eventStore.events.length}}
    <div class="row g-4">
      {{#each eventStore.events as |event|}}
        <div class="col-md-6 col-lg-4">
          {{event-card 
            event=event
            editingEventId=editingEventId
            editedEventTitle=editedEventTitle
            editedEventDate=editedEventDate
            editedEventDescription=editedEventDescription
            startEdit=(action "startEdit")
            deleteEvent=(action "deleteEvent")
            saveEdit=(action "saveEdit")
            cancelEdit=(action "cancelEdit")
          }}
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center py-5">
      <div class="mb-3 fs-1 gradient-text">📅</div>
      <h4 class="fw-bold text-secondary">No events yet</h4>
      <p class="text-muted">Start by adding your first event above.</p>
    </div>
  {{/if}}
</div>
